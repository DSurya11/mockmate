# Copy to .env and fill in. Never commit .env.

# AI models: free tiers, tried in order; a provider without a key is skipped.
# One key is enough (Groq); each extra one is a fallback when the others are rate-limited.
# Several keys for one provider: comma-separated (GROQ_API_KEY=key1,key2). Every key is tried on
# the best model before the next model; a rate-limited key rests for its Retry-After.
GROQ_API_KEY=            # https://console.groq.com/keys
MISTRAL_API_KEY=         # https://console.mistral.ai (free tier: the ministral models only)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (":free" models; the list changes, see llm.py)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
# Optional: order and models, "provider:model,...". Default in ai-service/app/services/llm.py.
LLM_CHAIN=

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Optional: resume file storage (Supabase). Leave empty locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
